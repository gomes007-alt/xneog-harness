{
  "name": "@xneog/dsh-http-proxy",
  "description": "Process-wide outbound HTTP proxy policy for xneog: resolve it from the launch environment and install it as undici's global dispatcher",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/util/http-proxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xneog/cordis": "workspace:^"
  },
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-invariants": "workspace:^"
  }
}
