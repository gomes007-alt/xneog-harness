{
  "name": "@xneog/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process xneog SDK clients",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xneog/dsh-brand": "workspace:^",
    "@xneog/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-attachment": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-llm-deepseek": "workspace:^",
    "@xneog/dsh-scope": "workspace:^",
    "@xneog/dsh-sdk-protocol": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-subagent": "workspace:^"
  },
  "devDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/cordis-plugin-loader": "workspace:^",
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-agent-loop": "workspace:^",
    "@xneog/dsh-agent-loop-testkit": "workspace:^",
    "@xneog/dsh-attachment": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-llm-deepseek": "workspace:^",
    "@xneog/dsh-scope": "workspace:^",
    "@xneog/dsh-sdk-protocol": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-session-persistence-jsonl": "workspace:^",
    "@xneog/dsh-session-projection": "workspace:^",
    "@xneog/dsh-subagent": "workspace:^"
  }
}
