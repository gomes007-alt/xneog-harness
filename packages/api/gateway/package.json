{
  "name": "@xneog/dsh-api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@xneog/dsh-typert-registry",
        "@xneog/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xneog/dsh-deque": "workspace:^",
    "@xneog/dsh-timeout": "workspace:^",
    "@xneog/schemastery": "workspace:^",
    "ws": "^8.21.0",
    "@xneog/dsh-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@xneog/cordis": "workspace:^"
  },
  "devDependencies": {
    "@xneog/dsh-brand": "workspace:^",
    "@xneog/dsh-client-connection": "workspace:^",
    "@xneog/dsh-host-webserver": "workspace:^",
    "@xneog/dsh-typert-registry": "workspace:^",
    "@xneog/dsh-util-crypto": "workspace:^",
    "@types/ws": "^8.18.1",
    "@xneog/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
