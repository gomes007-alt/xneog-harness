{
  "name": "@xneog/dsh-workflow-worker-thread",
  "description": "worker-thread workflow engine: executes model-written orchestration scripts off the host event loop, bridging agent() calls back to ctx.subagents",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/workflow/workflow-worker-thread"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-subagent": "workspace:^",
    "@xneog/dsh-tools": "workspace:^",
    "@xneog/dsh-workflow": "workspace:^"
  },
  "dependencies": {
    "@xneog/dsh-brand": "workspace:^",
    "@xneog/dsh-util-values": "workspace:^",
    "@xneog/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-agent-loop": "workspace:^",
    "@xneog/dsh-agent-loop-testkit": "workspace:^",
    "@xneog/dsh-invariants": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-session-projection": "workspace:^",
    "@xneog/dsh-subagent": "workspace:^",
    "@xneog/dsh-subagent-spawn-in-process": "workspace:^",
    "@xneog/dsh-system-prompt": "workspace:^",
    "@xneog/dsh-tools": "workspace:^",
    "@xneog/dsh-workflow": "workspace:^",
    "tsx": "^4.19.2",
    "@xneog/dsh-http-proxy": "workspace:^"
  }
}
