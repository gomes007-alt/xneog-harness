{
  "name": "@xneog/dsh-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the xneog web capability seam (ctx.web)",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-credentials": "workspace:^",
    "@xneog/dsh-launch-environment": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-web": "workspace:^",
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-settings": "workspace:^"
  },
  "dependencies": {
    "@xneog/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-credentials": "workspace:^",
    "@xneog/dsh-credentials-local": "workspace:^",
    "@xneog/dsh-launch-environment": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-web": "workspace:^",
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-settings": "workspace:^",
    "@xneog/dsh-http-proxy": "workspace:^"
  }
}
