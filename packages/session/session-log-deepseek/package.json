{
  "name": "@xneog/dsh-session-log-deepseek",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/session/session-log-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xneog/dsh-brand": "workspace:^",
    "@xneog/dsh-util-values": "workspace:^",
    "@xneog/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@xneog/dsh-invariants": "workspace:^",
    "@xneog/dsh-session": "workspace:^"
  },
  "devDependencies": {
    "@xneog/cordis": "workspace:^",
    "@xneog/cordis-plugin-include": "workspace:^",
    "@xneog/cordis-plugin-loader": "workspace:^",
    "@xneog/dsh-command-feedback": "workspace:^",
    "@xneog/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@xneog/dsh-invariants": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-llm-deepseek": "workspace:^",
    "@xneog/dsh-llm-mock-server": "workspace:^",
    "@xneog/dsh-message-feedback": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-session-persistence-jsonl": "workspace:^"
  }
}
