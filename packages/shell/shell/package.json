{
  "name": "@xneog/dsh-shell",
  "description": "Abstract bash executor seam (ctx.shell) for the xneog",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/shell/shell"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xneog/dsh-subprocess": "workspace:^",
    "@xneog/dsh-sandbox": "workspace:^",
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-settings": "workspace:^"
  },
  "devDependencies": {
    "@xneog/dsh-subprocess": "workspace:^",
    "@xneog/dsh-sandbox": "workspace:^",
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-settings": "workspace:^"
  }
}
