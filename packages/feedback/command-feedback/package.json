{
  "name": "@xneog/dsh-command-feedback",
  "description": "Log-only session feedback: the record event, the sessionFeedback Host Remote, and the human-facing slash command",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/feedback/command-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xneog/dsh-commands": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-anonymous-user-id": "workspace:^",
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-typert-protocol": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@xneog/cordis-plugin-include": "workspace:^",
    "@xneog/cordis-plugin-loader": "workspace:^",
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-agent-loop-testkit": "workspace:^",
    "@xneog/dsh-commands": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-anonymous-user-id": "workspace:^",
    "@xneog/cordis": "workspace:^",
    "@xneog/dsh-typert-protocol": "workspace:^"
  }
}
