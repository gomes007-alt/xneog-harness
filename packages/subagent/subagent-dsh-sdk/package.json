{
  "name": "@xneog/dsh-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child xneog runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomes007-alt/xneog-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-invariants": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-sdk-client": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-subagent": "workspace:^",
    "@xneog/dsh-subprocess": "workspace:^",
    "@xneog/cordis": "workspace:^"
  },
  "dependencies": {
    "@xneog/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@xneog/cordis-plugin-loader": "workspace:^",
    "@xneog/dsh-agent": "workspace:^",
    "@xneog/dsh-invariants": "workspace:^",
    "@xneog/dsh-llm": "workspace:^",
    "@xneog/dsh-loader-smoke": "workspace:^",
    "@xneog/dsh-sdk-client": "workspace:^",
    "@xneog/dsh-sdk-protocol": "workspace:^",
    "@xneog/dsh-session": "workspace:^",
    "@xneog/dsh-subagent": "workspace:^",
    "@xneog/dsh-subprocess": "workspace:^",
    "@xneog/cordis": "workspace:^"
  }
}
